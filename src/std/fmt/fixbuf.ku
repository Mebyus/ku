// Fixed buffer is a format buffer that operates stricly inside a given
// memory block (span of bytes) without any additional allocations.
//
// Due to its nature this buffer can only hold as much formatted
// text as the size of given memory allows. Any extra formatted bytes
// that do not fit are dropped.
pub
type Fixbuf struct {
	// Pointer to buffer memory.
	// Always not nil for initialized struct.
	ptr: [*]u8

	// Number of bytes that is already written to buffer.
	// Cannot be greater than capacity.
	num: uint

	// Buffer storage capacity. Max bytes it can hold.
	cap: uint

    // Indicates that buffer is full and no more formatted
    // data can be written to it.
    eof: bool
}

fun (&Fixbuf) reset() {
	g.num = 0;
    g.eof = false;
}

#[init]
fun (&Fixbuf) init(s: []u8) {
	must(s.num != 0);
	must(s.ptr != nil);

	g.ptr = s.ptr;
	g.cap = s.num;
    g.reset();
}

fun (&Fixbuf) tail() -> []u8 {
    if g.eof {
        return nil;
    }
    if g.num >= g.cap {
        g.eof = true;
        return nil;
    }

    body := g.ptr.[:g.cap];
    return body[g.num:];
}

fun (&Fixbuf) take() -> str {
    body := g.ptr.[:g.cap];
    s := cast(str, body[:g.num]);

    g.reset();
    return s;
}

fun (&Fixbuf) putb(x: u8) {
    tail := g.tail(buf);
    if tail.num == 0 {
        return;
    }
    if tail.num == 1 {
        g.eof = true;
    }

    tail.ptr.[0] = x;
    g.num += 1;
}

fun (&Fixbuf) putb_rep(x: u8, k: uint) {
    tail := g.tail();
    if tail.num == 0 {
        return;
    }

    n := min(tail.num, k);
    for i := [:n] {
        tail.ptr.[i] = x;
    }
    g.num += n;
    if n < k {
        g.eof = true;
    }
}

fun (&Fixbuf) line() {
    g.putb('\n');
}

fun (&Fixbuf) space() {
    g.putb(' ');
}

fun (&Fixbuf) space_rep(k: uint) {
    g.putb_rep(' ', k);
}

fun (&Fixbuf) puts(s: str) {
    if s.num == 0 {
        return;
    }

    tail := g.tail();
    if tail.num == 0 {
        return;
    }

    n := copy(tail, s);
    g.num += n;
    if n < s.len {
        g.eof = true;
    }
}

fun (&Fixbuf) dec_u64(x: u64) {
    tail := g.tail();
    if tail.num == 0 {
        return;
    }

    n := put_dec_u64(tail, x);
    g.num += n;
    if n == 0 {
        g.eof = true;
    }
}

fun (&FixedBuffer) put_hex_prefix_zeroes_u32(x: u32) {
    var tail: []u8 = g.tail();
    if tail.len == 0 {
        ret;
    }
    if tail.len < max_u32_hex_length {
        g.eof = true;
        ret;
    }

    put_hex_prefix_zeroes_u32(tail.ptr, x);
    g.len += max_u32_hex_length;
}

fun (&FixedBuffer) put_hex_prefix_zeroes_u64(x: u64) {
    var tail: []u8 = g.tail();
    if tail.len == 0 {
        ret;
    }
    if tail.len < max_u64_hex_length {
        g.eof = true;
        ret;
    }

    put_hex_prefix_zeroes_u64(tail.ptr, x);
    g.len += max_u64_hex_length;
}

fun (&FixedBuffer) put_bin_bytes_u16(x: u16) {
    var tail: []u8 = g.tail();
    if tail.len == 0 {
        ret;
    }
    if tail.len < bin_bytes_u16_length {
        g.eof = true;
        ret;
    }

    put_bin_bytes_u16(tail.ptr, x);
    g.len += bin_bytes_u16_length;
}

fun (&FixedBuffer) put_bin_bytes_u32(x: u32) {
    var tail: []u8 = g.tail();
    if tail.len == 0 {
        ret;
    }
    if tail.len < bin_bytes_u32_length {
        g.eof = true;
        ret;
    }

    put_bin_bytes_u32(tail.ptr, x);
    g.len += bin_bytes_u32_length;
}

fun (&Fixbuf) put_bits_f32(f: f32) {
    var tail: []u8 = g.tail();
    if tail.len == 0 {
        ret;
    }
    if tail.len < bits_f32_length {
        g.eof = true;
        ret;
    }

    put_bits_f32(tail.ptr, f);
    g.len += fmt_bits_f32_length;
}

fun (&Fixbuf) hex_bytes(s: []u8) {
    if s.num == 0 {
        return;
    }

    var tail: []u8 = g.tail();
    if tail.len == 0 {
        ret;
    }

    var len: uint = 3 * s.len - 1;
    if tail.len < len {
        g.eof = true;
        ret;
    }

    put_hex_byte(tail.ptr, s[0]);
    for i = [1:s.len] {
        var offset: uint = 3 * i - 1;
        tail.ptr.[offset] = ' ';
        put_hex_byte(tail.ptr + offset + 1, s[i]);
    }
    g.len += len;
}
